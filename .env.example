# Required for grounded generation and intent interpretation.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Leave these blank to use persistent local Qdrant storage.
# Set both values in Render to use Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# Optional collection and local-storage settings.
QDRANT_COLLECTION_NAME=documentation
QDRANT_PATH=vector_store